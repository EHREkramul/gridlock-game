# Port the HTTP + WebSocket server listens on
PORT=2567

# Optional. When set, rooms and matchmaking state live in Redis so you can run
# several server processes / machines behind a load balancer.
# REDIS_URL=redis://localhost:6379

# Optional, only with REDIS_URL: the address other nodes and clients use to
# reach THIS process directly (e.g. "node-1.gridlock.example.com").
# PUBLIC_ADDRESS=

# Comma-separated list of allowed web origins for the HTTP API ("*" = any)
CORS_ORIGIN=*
