{
  "name": "@gridlock/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Colyseus game server for Gridlock",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@colyseus/redis-driver": "^0.18.3",
    "@colyseus/redis-presence": "^0.18.5",
    "@colyseus/schema": "^5.0.34",
    "@colyseus/tools": "^0.18.1",
    "colyseus": "^0.18.8",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@colyseus/testing": "^0.18.5",
    "@gridlock/engine": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
